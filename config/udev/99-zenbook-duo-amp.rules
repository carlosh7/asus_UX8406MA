# ASUS Zenbook Duo UX8406MA - Auto-load CS35L41 right amplifier
# Matches the SOF audio PCI device (Intel Meteor Lake), then amp-enable.sh
# detects the correct card index dynamically (works with any card number)
SUBSYSTEM=="sound", ACTION=="add", KERNEL=="card*", ATTRS{driver}=="sof-audio-pci-intel-mtl", RUN+="/usr/local/bin/amp-enable.sh"