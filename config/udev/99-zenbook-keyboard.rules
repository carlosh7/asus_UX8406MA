# ASUS Zenbook Duo Keyboard (USB, 0b05:1b2c) - acceso solo por grupo
# (Fase 0: sustituye el MODE=0666 original, inseguro — hallazgo P0-1).
# Ronda 10: capturada al repo; existía solo en /etc del host (drift M1-class).
SUBSYSTEM=="usb", ATTR{idVendor}=="0b05", ATTR{idProduct}=="1b2c", MODE="0660", GROUP="input"
