[Unit]
Description=Zenbook Duo Bluetooth Keyboard Keycode Mapper
After=graphical.target

[Service]
Type=simple
ExecStart=/usr/local/bin/bt-keyboard-mapper.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# Sin Environment: el mapper resuelve el bus de sesión dinámicamente
# (loginctl) y hace drop de privilegios a la sesión gráfica cuando necesita
# D-Bus. %U en servicio de sistema expande a 0 → bus de root inexistente.

[Install]
WantedBy=graphical.target
