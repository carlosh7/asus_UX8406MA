[Unit]
Description=Zenbook Duo Keyboard Backlight (ambient light + inactivity)
After=graphical.target

[Service]
Type=simple
ExecStart=/usr/local/bin/kb-backlight-unified.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
# SIN Environment con %U: en servicios de sistema %U expande a 0 (root) y el
# bus resultante no existe → GetIdletime fallaba siempre y el idle-off nunca
# se activaba (luz de teclado encendida con pantalla apagada, ago-2026).
# El script resuelve el bus del usuario efectivo (User=) dinámicamente.

[Install]
WantedBy=graphical.target
