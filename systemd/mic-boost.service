[Unit]
Description=Microphone gain boost for internal Digital Microphone
After=graphical.target

[Service]
Type=oneshot
# SIN Environment con %U: en servicios de sistema %U expande a 0 (root) →
# pw-dump/wpctl no encontraban PipeWire y el boost no aplicaba nunca.
# El script deriva XDG_RUNTIME_DIR del UID efectivo (User=).
ExecStart=/usr/local/bin/mic-boost.sh
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
