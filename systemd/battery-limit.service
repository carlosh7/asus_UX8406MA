[Unit]
Description=Battery charge limit (set to 80% - Smart Charging)
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'for bat in /sys/class/power_supply/BAT*/charge_control_end_threshold; do [ -e "$bat" ] && echo 80 > "$bat"; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
